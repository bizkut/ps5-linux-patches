+static ssize_t usbc_debugfs_probe_write(struct file *file, const char __user *buf,
+					size_t count, loff_t *ppos)
+{
+	char input[32];
+	u16 msg_type;
+	u8 reply[ICC_MSG_MAX_SIZE];
+	int ret;
+	size_t reply_len;
+
+	if (count >= sizeof(input))
+		return -EINVAL;
+	if (copy_from_user(input, buf, count))
+		return -EFAULT;
+	input[count] = 0;
+
+	if (kstrtou16(input, 0, &msg_type))
+		return -EINVAL;
+
+	ret = ps5_usbc_probe_msg_type(msg_type, 0, reply, sizeof(reply));
+	if (ret) {
+		pr_info("[USBC] probe msg_type=0x%04X FAILED: %d\n", msg_type, ret);
+		return count;
+	}
+
+	reply_len = min_t(size_t, sizeof(reply), 32);
+	pr_info("[USBC] probe msg_type=0x%04X OK reply:", msg_type);
+	print_hex_dump(KERN_INFO, "[USBC]   ", DUMP_PREFIX_OFFSET,
+		       16, 1, reply, reply_len, true);
+	return count;
+}
+
+static const struct file_operations usbc_debugfs_probe_fops = {
+	.owner = THIS_MODULE,
+	.write = usbc_debugfs_probe_write,
+};
+
+static ssize_t usbc_debugfs_trigger_hpd_write(struct file *file, const char __user *buf,
+					       size_t count, loff_t *ppos)
+{
+	ps5_usbc_trigger_hpd();
+	return count;
+}
