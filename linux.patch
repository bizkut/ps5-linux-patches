+#ifdef CONFIG_X86_PS5
+	.enable_dp_output = dcn201_link_encoder_enable_dp_output,
+	.disable_output = dcn201_link_encoder_disable_output,
+#else
 	.enable_dp_output = dcn10_link_encoder_enable_dp_output,
-	.enable_dp_mst_output = dcn10_link_encoder_enable_dp_mst_output,
 	.disable_output = dcn10_link_encoder_disable_output,
+#endif
+	.enable_dp_mst_output = dcn10_link_encoder_enable_dp_mst_output,
 	.dp_set_lane_settings = dcn10_link_encoder_dp_set_lane_settings,
 	.dp_set_phy_pattern = dcn10_link_encoder_dp_set_phy_pattern,
 	.update_mst_stream_allocation_table =
@@ -98,11 +344,18 @@ static const struct link_encoder_funcs dcn201_link_enc_funcs = {
 	.disable_hpd = dcn10_link_encoder_disable_hpd,
 	.is_dig_enabled = dcn10_is_dig_enabled,
 	.destroy = dcn10_link_encoder_destroy,
+#ifndef CONFIG_X86_PS5
