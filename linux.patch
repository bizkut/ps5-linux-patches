+int ps5_usbc_register_hpd_callback(ps5_usbc_hpd_callback_t callback, void *data)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hpd_callback_lock, flags);
+	hpd_callback = callback;
+	hpd_callback_data = data;
+	spin_unlock_irqrestore(&hpd_callback_lock, flags);
+
+	pr_info("[USBC] HPD callback registered\n");
+
+	/* If a device is already connected, fire CONNECT immediately.
+	 * The USBC driver loads before amdgpu, so the initial connection
+	 * state is captured before the callback is registered.
+	 */
+	if (last_conn_state_valid && last_conn_state.dp_alt &&
+	    last_conn_state.conn_state) {
+		pr_info("[USBC] Device already connected, firing initial HPD CONNECT\n");
+		fire_hpd_event(PS5_USBC_HPD_CONNECT);
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(ps5_usbc_register_hpd_callback);
+
+void ps5_usbc_unregister_hpd_callback(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hpd_callback_lock, flags);
+	hpd_callback = NULL;
+	hpd_callback_data = NULL;
+	spin_unlock_irqrestore(&hpd_callback_lock, flags);
+
+	pr_info("[USBC] HPD callback unregistered\n");
+}
+EXPORT_SYMBOL(ps5_usbc_unregister_hpd_callback);
+
+bool ps5_usbc_is_dp_alt_active(u8 port_id)
+{
+	struct ps5_usbc_conn_state state;
+	int ret;
+
+	ret = ps5_usbc_get_conn_state(port_id, &state);
+	if (ret)
+		return false;
+
+	return state.dp_alt != 0 && state.conn_state != 0;
+}
+EXPORT_SYMBOL(ps5_usbc_is_dp_alt_active);
+
+static void hpd_connect_work_fn(struct work_struct *work)
+{
+	ps5_usbc_hpd_callback_t cb;
+	void *cb_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hpd_callback_lock, flags);
+	cb = hpd_callback;
+	cb_data = hpd_callback_data;
+	spin_unlock_irqrestore(&hpd_callback_lock, flags);
+
+	if (cb) {
+		pr_info("[USBC] Firing HPD CONNECT\n");
+		cb(PS5_USBC_HPD_CONNECT, cb_data);
+	}
+}
+
+static void hpd_disconnect_work_fn(struct work_struct *work)
+{
+	ps5_usbc_hpd_callback_t cb;
+	void *cb_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hpd_callback_lock, flags);
+	cb = hpd_callback;
+	cb_data = hpd_callback_data;
+	spin_unlock_irqrestore(&hpd_callback_lock, flags);
+
+	if (cb) {
+		pr_info("[USBC] Firing HPD DISCONNECT\n");
+		cb(PS5_USBC_HPD_DISCONNECT, cb_data);
+	}
+}
+
+static void fire_hpd_event(enum ps5_usbc_hpd_event event)
+{
+	if (!hpd_wq)
+		return;
+
+	switch (event) {
+	case PS5_USBC_HPD_CONNECT:
+		queue_work(hpd_wq, &hpd_connect_work);
+		break;
+	case PS5_USBC_HPD_DISCONNECT:
+		queue_work(hpd_wq, &hpd_disconnect_work);
+		break;
+	case PS5_USBC_HPD_IRQ:
+		queue_work(hpd_wq, &hpd_connect_work);
+		break;
+	default:
+		break;
+	}
+}
+
+/* Manually trigger HPD (for testing/debug) */
+void ps5_usbc_trigger_hpd(void)
+{
+	struct ps5_usbc_conn_state state;
+	int ret;
+
+	ret = ps5_usbc_get_conn_state((u8)usbc_port_id, &state);
+	if (ret) {
+		pr_warn("[USBC] trigger_hpd: failed to get conn state\n");
+		return;
+	}
+
+	/* Fire CONNECT when DP alt mode is active (DpAlt=1 and ConnState=1).
+	 * The Hpd field may be 0 initially — the display asserts HPD after
+	 * link training starts. We trigger CONNECT to begin that process.
+	 */
+	if (state.dp_alt && state.conn_state)
+		fire_hpd_event(PS5_USBC_HPD_CONNECT);
+	else
+		fire_hpd_event(PS5_USBC_HPD_DISCONNECT);
+}
+EXPORT_SYMBOL(ps5_usbc_trigger_hpd);
+
+/* Notification handler - called from spcie.c icc_notification_work_func */
+void usbc_notification_handler(struct icc_msg *msg)
+{
+	unsigned long flags;
+	enum ps5_usbc_hpd_event event = PS5_USBC_HPD_NONE;
+
+	/* Save raw notification for debug */
+	spin_lock_irqsave(&notif_lock, flags);
+	last_notif_len = min_t(size_t, msg->length, ICC_MSG_MAX_SIZE);
+	memcpy(last_notif, msg, last_notif_len);
+	spin_unlock_irqrestore(&notif_lock, flags);
+
+	pr_info("[USBC] notification msg_type=0x%04X len=%u\n",
+		msg->msg_type, msg->length);
+
+	if (msg->length > sizeof(*msg)) {
+		print_hex_dump(KERN_INFO, "[USBC] notif: ", DUMP_PREFIX_OFFSET,
+			       16, 1, msg->data, msg->length - sizeof(*msg), true);
+	}
+
+	/* Parse notification based on msg_type.
+	 * The notification data likely contains the same fields as
+	 * GET_DEV_CONN_STATE reply: PortId, ConnState, DevType, ...,
+	 * DpAlt, PinAssign, Hpd.
+	 */
+	if (msg->msg_type == notif_msg_type_conn_state) {
+		struct ps5_usbc_conn_state state = {};
+		u8 *d = msg->data;
+		size_t data_len = msg->length > sizeof(*msg) ?
+			msg->length - sizeof(*msg) : 0;
+
+		if (data_len >= 12) {
+			/* Skip 2-byte status header, same as GET_DEV_CONN_STATE */
+			state.port_id = d[2];
+			state.conn_state = d[3];
+			state.dev_type = d[4];
+			state.vconn_req = d[5];
+			state.power = d[6];
+			state.mux = d[7];
+			state.orient = d[8];
+			state.dp_alt = d[9];
+			state.pin_assign = d[10];
+			state.hpd = d[11];
+
+			dump_conn_state(&state, "notification");
+
+			if (state.dp_alt && state.conn_state)
+				event = PS5_USBC_HPD_CONNECT;
+			else
+				event = PS5_USBC_HPD_DISCONNECT;
+		}
+	} else {
+		/* Unknown notification msg_type - try to parse as conn state anyway */
+		u8 *d = msg->data;
+		size_t data_len = msg->length > sizeof(*msg) ?
+			msg->length - sizeof(*msg) : 0;
+
+		if (data_len >= 12) {
+			pr_info("[USBC] unknown notif, trying conn state parse:\n");
+			pr_info("[USBC]   PortId(%02X) ConnState(%u) DevType(%u) VconnReq(%u) Power(%u) Mux(%u) Orient(%u) DpAlt(%u) PinAssign(%u) Hpd(%u)\n",
+				d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11]);
+
+			if (d[9] /* dp_alt */ && d[3] /* conn_state */)
+				event = PS5_USBC_HPD_CONNECT;
+			else
+				event = PS5_USBC_HPD_DISCONNECT;
+		}
+	}
+
+	if (event != PS5_USBC_HPD_NONE)
+		fire_hpd_event(event);
+}
+EXPORT_SYMBOL(usbc_notification_handler);
+
+/* Polling workqueue - fallback for connection state monitoring */
+static void usbc_poll_fn(struct work_struct *work)
+{
+	struct ps5_usbc_conn_state state;
+	int ret;
+
+	ret = ps5_usbc_get_conn_state((u8)usbc_port_id, &state);
+	if (ret) {
+		schedule_delayed_work(&usbc_poll_work,
+				      msecs_to_jiffies(poll_interval_ms));
+		return;
+	}
+
+	if (!last_conn_state_valid) {
+		last_conn_state = state;
+		last_conn_state_valid = true;
+		/* If already connected at boot, fire connect event */
+		if (state.dp_alt && state.conn_state)
+			fire_hpd_event(PS5_USBC_HPD_CONNECT);
+	} else {
+		/* Detect changes in dp_alt + conn_state (connection status) */
+		bool was_connected = last_conn_state.dp_alt && last_conn_state.conn_state;
+		bool is_connected = state.dp_alt && state.conn_state;
+
+		if (is_connected && !was_connected)
+			fire_hpd_event(PS5_USBC_HPD_CONNECT);
+		else if (!is_connected && was_connected)
+			fire_hpd_event(PS5_USBC_HPD_DISCONNECT);
+
+		last_conn_state = state;
+	}
+
+	schedule_delayed_work(&usbc_poll_work, msecs_to_jiffies(poll_interval_ms));
+}
