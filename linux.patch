diff --git a/drivers/gpu/drm/amd/display/dc/dcn201/dcn201_link_encoder.c b/drivers/gpu/drm/amd/display/dc/dcn201/dcn201_link_encoder.c
index 9459e8f28..19aaf042a 100644
--- a/drivers/gpu/drm/amd/display/dc/dcn201/dcn201_link_encoder.c
+++ b/drivers/gpu/drm/amd/display/dc/dcn201/dcn201_link_encoder.c
@@ -33,6 +33,11 @@
 
 #include "gpio_service_interface.h"
 
+#ifdef CONFIG_X86_PS5
+#include <linux/delay.h>
+#include <linux/printk.h>
+#endif
+
 #define CTX \
 	enc10->base.ctx
 
@@ -56,7 +61,7 @@ static void dcn201_link_encoder_get_max_link_cap(struct link_encoder *enc,
 	struct dcn10_link_encoder *enc10 = TO_DCN10_LINK_ENC(enc);
 
 	dcn10_link_encoder_get_max_link_cap(enc, link_settings);
-	REG_GET_2(RDPCSTX_PHY_CNTL2, RDPCS_PHY_DPALT_DISABLE, &value1,
+	REG_GET_2(RDPCSTX_PHY_CNTL6, RDPCS_PHY_DPALT_DISABLE, &value1,
 		 RDPCS_PHY_DPALT_DP4, &value2);
 	/*limit to combo_phy*/
 	if (enc->usbc_combo_phy) {
@@ -70,12 +75,248 @@ static bool dcn201_link_encoder_is_in_alt_mode(struct link_encoder *enc)
 	uint32_t value;
 	struct dcn10_link_encoder *enc10 = TO_DCN10_LINK_ENC(enc);
 
-	REG_GET(RDPCSTX_PHY_CNTL2, RDPCS_PHY_DPALT_DISABLE, &value);
+	REG_GET(RDPCSTX_PHY_CNTL6, RDPCS_PHY_DPALT_DISABLE, &value);
 
 	// if value == 1 alt mode is disabled, otherwise it is enabled
 	return !value;
 }
 
+#ifdef CONFIG_X86_PS5
+/* PS5: Acquire combo PHY for USB-C DP alt mode.
+ * On PS5, the USB-C port is PSVR2-only and the firmware may not
+ * configure the combo PHY for DP alt mode. This function:
+ * 1. Checks if DP alt mode is enabled (RDPCS_PHY_DPALT_DISABLE == 0)
+ * 2. If not, tries to enable it by clearing DPALT_DISABLE
+ * 3. Acknowledges alt mode (DPALT_DISABLE_ACK = 0)
+ * 4. Enables DP reference clock (DP_REF_CLK_EN = 1)
+ * Based on dcn21_link_encoder_acquire_phy. DPALT bits and REF_CLK_EN
+ * are all in PHY_CNTL6 on DCN201 (same as DCN20/DCN21).
+ */
+static bool dcn201_link_encoder_acquire_phy(struct link_encoder *enc)
+{
+	struct dcn10_link_encoder *enc10 = TO_DCN10_LINK_ENC(enc);
+	uint32_t value, cntl2, cntl5, cntl6, cntl11;
+
+	if (!enc->features.flags.bits.DP_IS_USB_C) {
+		/* Non-USB-C (HDMI): dump registers for comparison, then enable ref clock */
+		uint32_t h0, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14;
+		h0 = REG_READ(RDPCSTX_PHY_CNTL0);
+		h2 = REG_READ(RDPCSTX_PHY_CNTL2);
+		h3 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL3);
+		h4 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL4);
+		h5 = REG_READ(RDPCSTX_PHY_CNTL5);
+		h6 = REG_READ(RDPCSTX_PHY_CNTL6);
+		h7 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL7);
+		h8 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL8);
+		h9 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL9);
+		h10 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL10);
+		h11 = REG_READ(RDPCSTX_PHY_CNTL11);
+		h12 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL12);
+		h13 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL13);
+		h14 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL14);
+		pr_info("PS5:  HDMI PHY CNTL0=0x%08x CNTL2=0x%08x CNTL3=0x%08x CNTL4=0x%08x",
+			h0, h2, h3, h4);
+		pr_info("PS5:  HDMI PHY CNTL5=0x%08x CNTL6=0x%08x CNTL7=0x%08x CNTL8=0x%08x",
+			h5, h6, h7, h8);
+		pr_info("PS5:  HDMI PHY CNTL9=0x%08x CNTL10=0x%08x CNTL11=0x%08x CNTL12=0x%08x",
+			h9, h10, h11, h12);
+		pr_info("PS5:  HDMI PHY CNTL13=0x%08x CNTL14=0x%08x",
+			h13, h14);
+		REG_UPDATE(RDPCSTX_PHY_CNTL6, RDPCS_PHY_DP_REF_CLK_EN, 1);
+		return true;
+	}
+
+	/* USB-C combo PHY: dump register state for debugging */
+	cntl2 = REG_READ(RDPCSTX_PHY_CNTL2);
+	cntl5 = REG_READ(RDPCSTX_PHY_CNTL5);
+	cntl6 = REG_READ(RDPCSTX_PHY_CNTL6);
+	cntl11 = REG_READ(RDPCSTX_PHY_CNTL11);
+	pr_info("PS5:  Combo PHY regs: CNTL2=0x%08x CNTL5=0x%08x CNTL6=0x%08x CNTL11=0x%08x",
+		cntl2, cntl5, cntl6, cntl11);
+	{
+		uint32_t cntl0;
+		cntl0 = REG_READ(RDPCSTX_PHY_CNTL0);
+		pr_info("PS5:  Combo PHY power: CNTL0=0x%08x", cntl0);
+
+		/* PS5 firmware leaves USB-C combo PHY in reset + HDMI mode.
+		 * Switch to DP mode and take PHY out of reset so AUX signals
+		 * can pass through to the USB-C display.
+		 *
+		 * RDPCS_PHY_HDMIMODE_ENABLE (bit 8): 1=HDMI, 0=DP
+		 * RDPCS_PHY_RESET (bit 0): 1=reset, 0=active
+		 */
+		if (cntl0 & (1 << 8)) {
+			pr_info("PS5:  PHY in HDMI mode, switching to DP mode");
+			/* Use dm_write_reg directly — REG_UPDATE may not stick */
+			dm_write_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL0,
+				     cntl0 & ~(1 << 8));
+			udelay(100);
+			cntl0 = REG_READ(RDPCSTX_PHY_CNTL0);
+			pr_info("PS5:  After HDMI->DP: CNTL0=0x%08x", cntl0);
+		}
+		if (cntl0 & 0x1) {
+			pr_info("PS5:  PHY in reset, taking out of reset");
+			dm_write_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL0,
+				     cntl0 & ~0x1);
+			udelay(1000);
+			cntl0 = REG_READ(RDPCSTX_PHY_CNTL0);
+			pr_info("PS5:  After reset release: CNTL0=0x%08x", cntl0);
+		}
+	}
+
+	/* Also dump AUX_CONTROL register */
+	{
+		uint32_t aux_ctrl, aux_rx0, aux_tx;
+		aux_ctrl = dm_read_reg(CTX, enc10->aux_regs->AUX_CONTROL);
+		aux_rx0 = dm_read_reg(CTX, enc10->aux_regs->AUX_DPHY_RX_CONTROL0);
+		aux_tx = dm_read_reg(CTX, enc10->aux_regs->AUX_DPHY_TX_CONTROL);
+		pr_info("PS5:  AUX_CONTROL=0x%08x AUX_DPHY_RX_CONTROL0=0x%08x AUX_DPHY_TX_CONTROL=0x%08x",
+			aux_ctrl, aux_rx0, aux_tx);
+
+		/* Fix AUX_HPD_SEL: USB-C uses HPD2 (source=2), but VBIOS may
+		 * have set HPD1 (source=1). AUX_HPD_SEL is bits 20:21.
+		 * Wrong HPD source causes AUX_RET_ERROR_HPD_DISCON.
+		 */
+		uint32_t hpd_sel = (aux_ctrl >> 20) & 3;
+		if (hpd_sel != 2) {
+			pr_info("PS5:  Fixing AUX_HPD_SEL: %d -> 2 (HPD2 for USB-C)", hpd_sel);
+			aux_ctrl = (aux_ctrl & ~(3 << 20)) | (2 << 20);
+		}
+
+		/* Set AUX_IGNORE_HPD_DISCON (bit 16) — PS5 USB-C HPD is
+		 * virtual (via ICC PD controller), not a physical HPD pin.
+		 * The AUX engine checks HPD before transactions and rejects
+		 * them with HPD_DISCON if HPD is low. Since the USB-C display
+		 * doesn't assert a physical HPD line, we must bypass this check.
+		 */
+		aux_ctrl |= (1 << 16);
+
+		/* Enable AUX engine if not already enabled (AUX_EN = bit 0) */
+		if (!(aux_ctrl & 0x1)) {
+			pr_info("PS5:  AUX engine not enabled, enabling now");
+			aux_ctrl |= 0x1;
+		}
+
+		/* Write updated AUX_CONTROL */
+		dm_write_reg(CTX, enc10->aux_regs->AUX_CONTROL, aux_ctrl);
+		udelay(100);
+		/* Read back to verify */
+		aux_ctrl = dm_read_reg(CTX, enc10->aux_regs->AUX_CONTROL);
+		pr_info("PS5:  After AUX fix: AUX_CONTROL=0x%08x (AUX_EN=%d HPD_SEL=%d)",
+			aux_ctrl, aux_ctrl & 0x1, (aux_ctrl >> 20) & 3);
+	}
+
+	/* Check DP alt mode status */
+	REG_GET(RDPCSTX_PHY_CNTL6, RDPCS_PHY_DPALT_DISABLE, &value);
+	pr_info("PS5:  Combo PHY DPALT_DISABLE = %d", value);
+
+	if (value == 1) {
+		/* DP alt mode is disabled. The combo PHY has not been
+		 * configured for DP alt mode (expected on PS5 since the
+		 * USB-C port is PSVR2-only and firmware doesn't init it).
+		 * Try to enable it by clearing DPALT_DISABLE.
+		 */
+		pr_info("PS5:  Enabling DP alt mode on combo PHY");
+		REG_UPDATE(RDPCSTX_PHY_CNTL6,
+				RDPCS_PHY_DPALT_DISABLE, 0);
+		udelay(100);
+
+		REG_GET(RDPCSTX_PHY_CNTL6,
+				RDPCS_PHY_DPALT_DISABLE, &value);
+		pr_info("PS5:  After enable, DPALT_DISABLE = %d", value);
+		if (value == 1) {
+			pr_info("PS5:  Failed to enable DP alt mode (hardware refused)\n");
+			return false;
+		}
+	}
+
+	/* Acknowledge DP alt mode */
+	REG_UPDATE(RDPCSTX_PHY_CNTL6,
+			RDPCS_PHY_DPALT_DISABLE_ACK, 0);
+	udelay(40);
+
+	/* Verify alt mode is still active */
+	REG_GET(RDPCSTX_PHY_CNTL6,
+			RDPCS_PHY_DPALT_DISABLE, &value);
+	if (value == 1) {
+		pr_info("PS5:  DP alt mode disabled after ACK\n");
+		REG_UPDATE(RDPCSTX_PHY_CNTL6,
+				RDPCS_PHY_DPALT_DISABLE_ACK, 1);
+		return false;
+	}
+
+	pr_info("PS5:  Combo PHY acquired for DP alt mode");
+
+	/* Dump all PHY CNTL registers for debugging */
+	{
+		uint32_t c0, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14;
+		c0 = REG_READ(RDPCSTX_PHY_CNTL0);
+		c2 = REG_READ(RDPCSTX_PHY_CNTL2);
+		c3 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL3);
+		c4 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL4);
+		c5 = REG_READ(RDPCSTX_PHY_CNTL5);
+		c6 = REG_READ(RDPCSTX_PHY_CNTL6);
+		c7 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL7);
+		c8 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL8);
+		c9 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL9);
+		c10 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL10);
+		c11 = REG_READ(RDPCSTX_PHY_CNTL11);
+		c12 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL12);
+		c13 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL13);
+		c14 = dm_read_reg(CTX, enc10->link_regs->RDPCSTX_PHY_CNTL14);
+		pr_info("PS5:  PHY CNTL0=0x%08x CNTL2=0x%08x CNTL3=0x%08x CNTL4=0x%08x",
+			c0, c2, c3, c4);
+		pr_info("PS5:  PHY CNTL5=0x%08x CNTL6=0x%08x CNTL7=0x%08x CNTL8=0x%08x",
+			c5, c6, c7, c8);
+		pr_info("PS5:  PHY CNTL9=0x%08x CNTL10=0x%08x CNTL11=0x%08x CNTL12=0x%08x",
+			c9, c10, c11, c12);
+		pr_info("PS5:  PHY CNTL13=0x%08x CNTL14=0x%08x",
+			c13, c14);
+	}
+
+	/* Enable DP reference clock for USB-C combo PHY */
+	REG_UPDATE(RDPCSTX_PHY_CNTL6, RDPCS_PHY_DP_REF_CLK_EN, 1);
+
+	return true;
+}
+
+static void dcn201_link_encoder_release_phy(struct link_encoder *enc)
+{
+	struct dcn10_link_encoder *enc10 = TO_DCN10_LINK_ENC(enc);
+
+	if (enc->features.flags.bits.DP_IS_USB_C) {
+		REG_UPDATE(RDPCSTX_PHY_CNTL6,
+				RDPCS_PHY_DPALT_DISABLE_ACK, 1);
+	}
+
+	REG_UPDATE(RDPCSTX_PHY_CNTL6, RDPCS_PHY_DP_REF_CLK_EN, 0);
+}
+
+static void dcn201_link_encoder_enable_dp_output(
+	struct link_encoder *enc,
+	const struct dc_link_settings *link_settings,
+	enum clock_source_id clock_source)
+{
+	if (!dcn201_link_encoder_acquire_phy(enc)) {
+		pr_info("PS5:  Failed to acquire PHY for USB-C DP output\n");
+		return;
+	}
+
+	dcn10_link_encoder_enable_dp_output(enc, link_settings, clock_source);
+}
+
+static void dcn201_link_encoder_disable_output(
+	struct link_encoder *enc,
+	enum signal_type signal)
+{
+	dcn10_link_encoder_disable_output(enc, signal);
+
+	if (enc->features.flags.bits.DP_IS_USB_C &&
+	    dc_is_dp_signal(signal))
+		dcn201_link_encoder_release_phy(enc);
+}
+#endif
+
 static const struct link_encoder_funcs dcn201_link_enc_funcs = {
 	.read_state = link_enc2_read_state,
 	.validate_output_with_stream =
@@ -83,9 +324,14 @@ static const struct link_encoder_funcs dcn201_link_enc_funcs = {
 	.hw_init = enc2_hw_init,
