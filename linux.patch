+int ps5_usbc_set_supported_device_list(u8 port_id, const u8 *devices, u8 device_num)
+{
+	u8 buf[ICC_MSG_MAX_SIZE] = {};
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int i;
+
+	if (device_num > 8)
+		return -EINVAL;
+
+	msg->service_id = ICC_SERVICE_ID_USBC;
+	msg->msg_type = msg_type_set_supported_device_list;
+	msg->length = ICC_MSG_MIN_SIZE;
+	msg->data[0] = port_id;
+	msg->data[1] = device_num;
+
+	/* Each device entry is 3 bytes (from firmware disassembly:
+	 * lea rcx, [rax + rax*2] = device_num * 3)
+	 */
+	for (i = 0; i < device_num && i < 8; i++) {
+		msg->data[2 + i * 3] = devices[i];
+		msg->length += 3;
+	}
+
+	pr_info("[USBC] SET_SUPPORTED_DEVICE_LIST PortId(%02X) DeviceNum(%02X)\n",
+		port_id, device_num);
+
+	return icc_query(buf, buf);
+}
+EXPORT_SYMBOL(ps5_usbc_set_supported_device_list);
