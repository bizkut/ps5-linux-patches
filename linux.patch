+static struct delayed_work usbc_init_work;
+static bool usbc_initialized;
+
+static void ps5_usbc_do_init(struct work_struct *work)
+{
+	int ret;
+
+	if (!spcie_is_initialized()) {
+		pr_info("[USBC] spcie not initialized, retrying in 1s\n");
+		schedule_delayed_work(&usbc_init_work, msecs_to_jiffies(1000));
+		return;
+	}
+
+	/* Create dedicated HPD workqueue (dc_link_detect can sleep) */
+	hpd_wq = alloc_workqueue("ps5_usbc_hpd", WQ_UNBOUND, 0);
+	INIT_WORK(&hpd_connect_work, hpd_connect_work_fn);
+	INIT_WORK(&hpd_disconnect_work, hpd_disconnect_work_fn);
+
+	/* Enable DP alt mode on the USB-C port */
+	ret = ps5_usbc_set_pdcon_op_mode((u8)usbc_port_id, (u8)pdcon_op_mode);
+	if (ret)
+		pr_warn("[USBC] SET_PDCON_OP_MODE failed: %d\n", ret);
+
+	/* Enable DP power delivery (OPT_PDP_ENABLE) */
+	ret = ps5_usbc_set_opt_pdp_enable((u8)usbc_port_id, (u8)opt_pdp_enable);
+	if (ret)
+		pr_warn("[USBC] SET_OPT_PDP_ENABLE failed: %d\n", ret);
+
+	/* Notify SOC that we're working */
+	ret = ps5_usbc_notify_soc_working((u8)usbc_port_id);
+	if (ret)
+		pr_warn("[USBC] NOTIFY_SOC_WORKING failed: %d\n", ret);
+
+	/* Get initial connection state */
+	ret = ps5_usbc_get_conn_state((u8)usbc_port_id, &last_conn_state);
+	if (ret) {
+		pr_warn("[USBC] initial GET_DEV_CONN_STATE failed: %d\n", ret);
+		last_conn_state_valid = false;
+	} else {
+		last_conn_state_valid = true;
+		if (last_conn_state.dp_alt && last_conn_state.conn_state)
+			pr_info("[USBC] DP alt mode active at boot\n");
+		else
+			pr_info("[USBC] DP alt mode not active at boot\n");
+	}
+
+	/* Start polling for connection state changes */
+	if (poll_enabled) {
+		INIT_DELAYED_WORK(&usbc_poll_work, usbc_poll_fn);
+		schedule_delayed_work(&usbc_poll_work,
+				      msecs_to_jiffies(poll_interval_ms));
+	}
+
+	/* Create debugfs interface */
+	usbc_debugfs_dir = debugfs_create_dir("ps5_usbc", NULL);
+	if (usbc_debugfs_dir) {
+		debugfs_create_file("conn_state", 0444, usbc_debugfs_dir, NULL,
+				    &usbc_debugfs_conn_state_fops);
+		debugfs_create_file("last_notif", 0444, usbc_debugfs_dir, NULL,
+				    &usbc_debugfs_last_notif_fops);
+		debugfs_create_file("probe", 0220, usbc_debugfs_dir, NULL,
+				    &usbc_debugfs_probe_fops);
+		debugfs_create_file("trigger_hpd", 0220, usbc_debugfs_dir, NULL,
+				    &usbc_debugfs_trigger_hpd_fops);
+	}
+
+	usbc_initialized = true;
+	pr_info("[USBC] PS5 USB-C DP alt mode driver initialized\n");
+}
+
+static int __init ps5_usbc_init(void)
+{
+	INIT_DELAYED_WORK(&usbc_init_work, ps5_usbc_do_init);
+	schedule_delayed_work(&usbc_init_work, msecs_to_jiffies(1000));
+	return 0;
+}
+
+static void __exit ps5_usbc_exit(void)
+{
+	cancel_delayed_work_sync(&usbc_init_work);
+
+	if (usbc_initialized && poll_enabled)
+		cancel_delayed_work_sync(&usbc_poll_work);
+
+	if (hpd_wq) {
+		cancel_work_sync(&hpd_connect_work);
+		cancel_work_sync(&hpd_disconnect_work);
+		destroy_workqueue(hpd_wq);
+		hpd_wq = NULL;
+	}
+
+	debugfs_remove_recursive(usbc_debugfs_dir);
+	ps5_usbc_unregister_hpd_callback();
+	pr_info("[USBC] PS5 USB-C DP alt mode driver removed\n");
+}
+
+/* The spcie driver is a PCI driver that probes asynchronously.
+ * Use a delayed workqueue to retry until spcie is ready.
+ */
+late_initcall(ps5_usbc_init);
+module_exit(ps5_usbc_exit);
+
+MODULE_AUTHOR("PS5 Linux Community");
+MODULE_DESCRIPTION("PS5 USB-C DisplayPort alt mode driver");
+MODULE_LICENSE("GPL");
