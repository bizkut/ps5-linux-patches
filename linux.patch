+static int usbc_debugfs_last_notif_show(struct seq_file *m, void *data)
+{
+	unsigned long flags;
+	u8 buf[ICC_MSG_MAX_SIZE];
+	size_t len;
+	struct icc_msg *msg;
+	u8 *d;
+	size_t data_len;
+	int i;
+
+	spin_lock_irqsave(&notif_lock, flags);
+	len = last_notif_len;
+	memcpy(buf, last_notif, len);
+	spin_unlock_irqrestore(&notif_lock, flags);
+
+	if (len == 0) {
+		seq_puts(m, "No notifications received yet\n");
+		return 0;
+	}
+
+	msg = (struct icc_msg *)buf;
+	seq_printf(m, "msg_type=0x%04X length=%u\n", msg->msg_type, msg->length);
+	data_len = len > sizeof(*msg) ? len - sizeof(*msg) : 0;
+	d = msg->data;
+	seq_printf(m, "data (%zu bytes):", data_len);
+	for (i = 0; i < data_len; i++)
+		seq_printf(m, " %02x", d[i]);
+	seq_putc(m, '\n');
+
+	if (data_len >= 10) {
+		seq_printf(m, "Parsed: PortId(%02X) ConnState(%u) DevType(%u) VconnReq(%u) Power(%u) Mux(%u) Orient(%u) DpAlt(%u) PinAssign(%u) Hpd(%u)\n",
+			d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9]);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(usbc_debugfs_last_notif);
