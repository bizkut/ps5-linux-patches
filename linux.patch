diff --git a/drivers/ps5/usbc.c b/drivers/ps5/usbc.c
new file mode 100644
index 000000000..9a6c55a99
--- /dev/null
+++ b/drivers/ps5/usbc.c
@@ -0,0 +1,759 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PS5 USB-C DP alt mode driver
+ *
+ * Communicates with the south bridge EMC FW via ICC USBC service
+ * (service_id 0x12) to manage USB-C DisplayPort alternate mode.
+ *
+ * The EMC FW handles PD negotiation and mux configuration in firmware.
+ * This driver queries connection state, receives hotplug notifications,
+ * and forwards HPD events to the amdgpu display driver.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/ps5.h>
+#include <linux/workqueue.h>
+#include <linux/spinlock.h>
+#include <linux/delay.h>
+#include <linux/slab.h>
+#include <linux/kstrtox.h>
+#include <linux/debugfs.h>
+#include <linux/uaccess.h>
+
+/* ICC USBC msg_type values.
+ *
+ * All values confirmed from PS5 5.50 firmware kernel dump disassembly.
+ */
+static ushort msg_type_get_service_state = 0x00;
+module_param(msg_type_get_service_state, ushort, 0644);
+MODULE_PARM_DESC(msg_type_get_service_state, "ICC USBC GET_SERVICE_STATE msg_type");
+
+static ushort msg_type_get_port_list = 0x01;
+module_param(msg_type_get_port_list, ushort, 0644);
+MODULE_PARM_DESC(msg_type_get_port_list, "ICC USBC GET_PORT_LIST msg_type");
+
+static ushort msg_type_get_dev_conn_state = 0x0c;
+module_param(msg_type_get_dev_conn_state, ushort, 0644);
+MODULE_PARM_DESC(msg_type_get_dev_conn_state, "ICC USBC GET_DEV_CONN_STATE msg_type");
+
+static ushort msg_type_set_pdcon_op_mode = 0x10;
+module_param(msg_type_set_pdcon_op_mode, ushort, 0644);
+MODULE_PARM_DESC(msg_type_set_pdcon_op_mode, "ICC USBC SET_PDCON_OP_MODE msg_type");
+
+static ushort msg_type_get_pdcon_op_mode = 0x11;
+module_param(msg_type_get_pdcon_op_mode, ushort, 0644);
+MODULE_PARM_DESC(msg_type_get_pdcon_op_mode, "ICC USBC GET_PDCON_OP_MODE msg_type");
+
+static ushort msg_type_set_opt_pdp_enable = 0x12;
+module_param(msg_type_set_opt_pdp_enable, ushort, 0644);
+MODULE_PARM_DESC(msg_type_set_opt_pdp_enable, "ICC USBC SET_OPT_PDP_ENABLE msg_type");
+
+static ushort msg_type_notify_soc_working = 0x15;
+module_param(msg_type_notify_soc_working, ushort, 0644);
+MODULE_PARM_DESC(msg_type_notify_soc_working, "ICC USBC NOTIFY_SOC_WORKING msg_type");
+
+static ushort msg_type_notify_soc_download_standby = 0x16;
+module_param(msg_type_notify_soc_download_standby, ushort, 0644);
+MODULE_PARM_DESC(msg_type_notify_soc_download_standby, "ICC USBC NOTIFY_SOC_DOWNLOAD_STANDBY msg_type");
+
+static ushort msg_type_set_supported_device_list = 0x19;
+module_param(msg_type_set_supported_device_list, ushort, 0644);
+MODULE_PARM_DESC(msg_type_set_supported_device_list, "ICC USBC SET_SUPPORTED_DEVICE_LIST msg_type");
+
+static ushort msg_type_get_pdcon_ic_type = 0x1b;
+module_param(msg_type_get_pdcon_ic_type, ushort, 0644);
+MODULE_PARM_DESC(msg_type_get_pdcon_ic_type, "ICC USBC GET_PDCON_IC_TYPE msg_type");
+
+static ushort msg_type_get_pdcon_fw_ver = 0x1c;
+module_param(msg_type_get_pdcon_fw_ver, ushort, 0644);
+MODULE_PARM_DESC(msg_type_get_pdcon_fw_ver, "ICC USBC GET_PDCON_FW_VER msg_type");
+
+static ushort msg_type_set_redriver_eqval = 0x20;
+module_param(msg_type_set_redriver_eqval, ushort, 0644);
+MODULE_PARM_DESC(msg_type_set_redriver_eqval, "ICC USBC SET_REDRIVER_EQVAL msg_type");
+
+/* OpMode for SET_PDCON_OP_MODE.
+ * 5 = USB + DP (current value used by existing patch).
+ * The PS5 OS also uses OpMode 4 in some contexts.
+ */
+static ushort pdcon_op_mode = 5;
+module_param(pdcon_op_mode, ushort, 0644);
+MODULE_PARM_DESC(pdcon_op_mode, "PDCON OpMode (5=USB+DP, 4=USB only?)");
+
+/* Enable value for SET_OPT_PDP_ENABLE.
+ * 1 = enable DP power delivery (confirmed from firmware disassembly).
+ * 2 = also accepted by firmware (meaning unclear, possibly disable or alt mode).
+ */
+static ushort opt_pdp_enable = 1;
+module_param(opt_pdp_enable, ushort, 0644);
+MODULE_PARM_DESC(opt_pdp_enable, "SET_OPT_PDP_ENABLE value (1=enable, 2=alt)");
+
+/* Port ID for ICC USBC commands.
+ * The PS5 has one USB-C port. GET_DEV_CONN_STATE reply shows PortId=3
+ * when queried with port_id=0. Try 3 if commands to port 0 don't work.
+ * The PS5 OS firmware uses PortId(00) for SET_PDCON_OP_MODE.
+ */
+static ushort usbc_port_id = 0;
+module_param(usbc_port_id, ushort, 0644);
+MODULE_PARM_DESC(usbc_port_id, "USB-C port ID for ICC commands (0 or 3)");
+
+/* Notification msg_type for connection state change.
+ * Based on the pattern (HDMI: 0x02, BUTTON: 0x8010/0x8011).
+ * USBC notifications likely use 0x80xx.
+ */
+static ushort notif_msg_type_conn_state = 0x8001;
+module_param(notif_msg_type_conn_state, ushort, 0644);
+MODULE_PARM_DESC(notif_msg_type_conn_state, "USBC notification msg_type for connection state change");
+
+/* HPD callback registered by amdgpu_dm */
+static ps5_usbc_hpd_callback_t hpd_callback;
+static void *hpd_callback_data;
+static DEFINE_SPINLOCK(hpd_callback_lock);
+
+/* Dedicated workqueue for HPD events (dc_link_detect can sleep) */
+static struct workqueue_struct *hpd_wq;
+static struct work_struct hpd_connect_work;
+static struct work_struct hpd_disconnect_work;
+
+/* Polling state for connection monitoring (fallback if notifications don't work) */
+static struct delayed_work usbc_poll_work;
+static bool poll_enabled = true;
+module_param(poll_enabled, bool, 0644);
+MODULE_PARM_DESC(poll_enabled, "Enable connection state polling fallback");
+
+static unsigned int poll_interval_ms = 500;
+module_param(poll_interval_ms, uint, 0644);
+MODULE_PARM_DESC(poll_interval_ms, "Connection state poll interval in ms");
+
+/* Last known connection state for change detection */
+static struct ps5_usbc_conn_state last_conn_state;
+static bool last_conn_state_valid;
+
+/* Debug: last raw notification */
+static u8 last_notif[ICC_MSG_MAX_SIZE];
+static size_t last_notif_len;
+static DEFINE_SPINLOCK(notif_lock);
+
+/* Forward declarations */
+static void fire_hpd_event(enum ps5_usbc_hpd_event event);
+
+/* Dumps the connection state in the format matching the PS5 firmware:
+ * PortId, ConnState, DevType, VconnReq, Power, Mux, Orient, DpAlt, PinAssign, Hpd
+ */
+static void dump_conn_state(const struct ps5_usbc_conn_state *s, const char *prefix)
+{
+	pr_info("[USBC] %s PortId(%02X) ConnState(%u) DevType(%u) VconnReq(%u) Power(%u) Mux(%u) Orient(%u) DpAlt(%u) PinAssign(%u) Hpd(%u)\n",
+		prefix, s->port_id, s->conn_state, s->dev_type,
+		s->vconn_req, s->power, s->mux, s->orient,
+		s->dp_alt, s->pin_assign, s->hpd);
+}
+
+/* Build and send an ICC USBC query, returning the reply */
+static int usbc_query(u16 msg_type, u8 port_id, u8 *reply, size_t reply_size)
+{
+	u8 buf[ICC_MSG_MAX_SIZE] = {};
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	if (!spcie_is_initialized())
+		return -ENODEV;
+
+	msg->service_id = ICC_SERVICE_ID_USBC;
+	msg->msg_type = msg_type;
+	msg->length = ICC_MSG_MIN_SIZE;
+	msg->data[0] = port_id;
+
+	ret = icc_query(buf, buf);
+	if (ret)
+		return ret;
+
+	if (reply && reply_size > 0) {
+		msg = (struct icc_msg *)buf;
+		if (msg->length > sizeof(*msg)) {
+			size_t copy_len = min_t(size_t, msg->length - sizeof(*msg), reply_size);
+			memcpy(reply, msg->data, copy_len);
+		}
+	}
+
+	return 0;
+}
+
+int ps5_usbc_get_conn_state(u8 port_id, struct ps5_usbc_conn_state *state)
+{
+	u8 reply[ICC_MSG_MAX_SIZE];
+	int ret;
+
+	if (!state)
+		return -EINVAL;
+
+	ret = usbc_query(msg_type_get_dev_conn_state, port_id, reply, sizeof(reply));
+	if (ret) {
+		pr_err("GET_DEV_CONN_STATE [NG][%d] PortId(%02X)\n", ret, port_id);
+		return ret;
+	}
+
+	/* Reply data layout (from PS5 firmware dump format string).
+	 * The first 2 bytes of reply data are a status/header (00 00 = OK).
+	 * Actual connection state starts at data[2].
+	 * data[0] = status_hi
+	 * data[1] = status_lo
+	 * data[2] = PortId
+	 * data[3] = ConnState
+	 * data[4] = DevType
+	 * data[5] = VconnReq
+	 * data[6] = Power
+	 * data[7] = Mux
+	 * data[8] = Orient
+	 * data[9] = DpAlt
+	 * data[10] = PinAssign
+	 * data[11] = Hpd
+	 */
+	state->port_id = reply[2];
+	state->conn_state = reply[3];
+	state->dev_type = reply[4];
+	state->vconn_req = reply[5];
+	state->power = reply[6];
+	state->mux = reply[7];
+	state->orient = reply[8];
+	state->dp_alt = reply[9];
+	state->pin_assign = reply[10];
+	state->hpd = reply[11];
+
+	dump_conn_state(state, "GET_DEV_CONN_STATE [OK]");
+	return 0;
+}
+EXPORT_SYMBOL(ps5_usbc_get_conn_state);
+
+int ps5_usbc_set_pdcon_op_mode(u8 port_id, u8 op_mode)
+{
+	u8 buf[ICC_MSG_MAX_SIZE] = {};
